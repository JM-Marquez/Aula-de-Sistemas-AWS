
{
  "$comment": "Una Lambda por ruta. Esta lista la consume el empaquetado y la plantilla de infraestructura. access indica los permisos sobre la tabla; sendsEmail indica si envía correo y readsAdmins si consulta los administradores.",
  "functions": [
    {
      "name": "auth-login",
      "method": "POST",
      "path": "/auth/login",
      "entry": "src/handlers/auth/login.ts",
      "auth": false,
      "access": "read",
      "sendsEmail": false,
      "readsAdmins": true
    },
    {
      "name": "auth-register",
      "method": "POST",
      "path": "/auth/register",
